  "item": [
    {
      "name": "Courses",
      "item": [
        {
          "name": "Get all courses",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/courses",
              "host": ["{{baseUrl}}"],
              "path": ["api", "courses"]
            }
          }
        },
        {
          "name": "Get course by id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/courses/{{courseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "courses", "{{courseId}}"]
            }
          }
        },
        {
          "name": "Search course by title",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/courses/search?title=Java%20Backend%20Foundations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "courses", "search"],
              "query": [
                { "key": "title", "value": "Java Backend Foundations" }
              ]
            }
          }
        },
        {
          "name": "Create course (teacherId/categoryId supported)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Spring Boot\",\n  \"description\": \"REST + JPA\",\n  \"price\": 199.99,\n  \"durationWeeks\": 8,\n  \"teacher\": { \"id\": {{teacherId}} },\n  \"category\": { \"id\": {{categoryId}} }\n}\n"
            },
            "url": {
              "raw": "{{baseUrl}}/api/courses",
              "host": ["{{baseUrl}}"],
              "path": ["api", "courses"]
            }
          }
        },
        {
          "name": "Update course (PUT)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Spring Boot Advanced\",\n  \"description\": \"Security + Testing\",\n  \"price\": 249.99,\n  \"durationWeeks\": 10,\n  \"teacher\": { \"id\": {{teacherId}} },\n  \"category\": { \"id\": {{categoryId}} }\n}\n"
            },
            "url": {
              "raw": "{{baseUrl}}/api/courses/{{courseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "courses", "{{courseId}}"]
            }
          }
        },
        {
          "name": "Patch course (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Patched title\",\n  \"price\": 149.99\n}\n"
            },
            "url": {
              "raw": "{{baseUrl}}/api/courses/{{courseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "courses", "{{courseId}}"]
            }
          }
        },
        {
          "name": "Delete course",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/courses/{{courseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "courses", "{{courseId}}"]
            }
          }
        },
        {
          "name": "Filter courses (JPQL + Pageable + Cache)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/courses/filter?department=Computer%20Science&category=Development&minPrice=0&maxPrice=500&page=0&size=2&sort=id,desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "courses", "filter"],
              "query": [
                { "key": "department", "value": "Computer Science" },
                { "key": "category", "value": "Development" },
                { "key": "minPrice", "value": "0" },
                { "key": "maxPrice", "value": "500" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "2" },
                { "key": "sort", "value": "id,desc" }
              ]
            }
          }
