            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/courses/99999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "courses", "99999"]
            }
          },
          "response": []
        },
        {
          "name": "400 Bad Request - Неверный ID",
          "request": {
            "method": "GET", 
            "url": {
              "raw": "{{baseUrl}}/api/courses/abc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "courses", "abc"]
            }
          },
          "response": []
        },
        {
          "name": "500 Internal Server Error - Ошибка базы данных",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/test/database-error",
              "host": ["{{baseUrl}}"],
              "path": ["api", "test", "database-error"]
            }
