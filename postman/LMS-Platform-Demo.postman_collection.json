    {
      "name": "7. Async + Concurrency (Race Condition)",
      "description": "Демонстрация: 1) асинхронная бизнес-операция с taskId и статусом 2) потокобезопасные счетчики 3) race condition и его решение",
      "item": [
        {
          "name": "Async - Start task (returns taskId)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/async-tasks?steps=10&delayMs=100",
              "host": ["{{baseUrl}}"],
              "path": ["api", "async-tasks"],
              "query": [
                { "key": "steps", "value": "10" },
                { "key": "delayMs", "value": "100" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.taskId) {",
                  "  pm.collectionVariables.set('taskId', json.taskId);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Async - Get task status by taskId",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/async-tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "async-tasks", "{{taskId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Counter - Increment UNSAFE (not thread-safe)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/concurrency/counter/increment?type=UNSAFE&times=1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "concurrency", "counter", "increment"],
              "query": [
                { "key": "type", "value": "UNSAFE" },
                { "key": "times", "value": "1" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Counter - Increment SYNCHRONIZED (thread-safe)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/concurrency/counter/increment?type=SYNCHRONIZED&times=1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "concurrency", "counter", "increment"],
              "query": [
                { "key": "type", "value": "SYNCHRONIZED" },
                { "key": "times", "value": "1" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Counter - Increment ATOMIC (thread-safe)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/concurrency/counter/increment?type=ATOMIC&times=1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "concurrency", "counter", "increment"],
              "query": [
                { "key": "type", "value": "ATOMIC" },
                { "key": "times", "value": "1" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Race demo - 50 threads x 1000 increments",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/concurrency/race-demo?threads=50&incrementsPerThread=1000",
              "host": ["{{baseUrl}}"],
              "path": ["api", "concurrency", "race-demo"],
              "query": [
                { "key": "threads", "value": "50" },
                { "key": "incrementsPerThread", "value": "1000" }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Дополнительная демонстрация - Кеширование",
      "description": "Проверка работы кеша с CACHE_HIT/CACHE_MISS",
      "item": [
        {
          "name": "Первый запрос - CACHE_MISS",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/courses/filter?department=Software%20Engineering&category=Development&page=0&size=2",
              "host": ["{{baseUrl}}"],
              "path": ["api", "courses", "filter"],
              "query": [
                { "key": "department", "value": "Software Engineering" },
                { "key": "category", "value": "Development" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "2" }
              ]
            },
            "description": "В логах увидишь: CACHE_MISS entity=Course"
          },
          "response": []
        },
        {
          "name": "Второй запрос - CACHE_HIT",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/courses/filter?department=Software%20Engineering&category=Development&page=0&size=2",
              "host": ["{{baseUrl}}"],
              "path": ["api", "courses", "filter"],
              "query": [
                { "key": "department", "value": "Software Engineering" },
                { "key": "category", "value": "Development" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "2" }
              ]
            },
            "description": "В логах увидишь: CACHE_HIT entity=Course"
          },
          "response": []
        },
        {
          "name": "Инвалидация кеша",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Новый курс\",\n  \"description\": \"Описание\",\n  \"price\": 199.99,\n  \"durationWeeks\": 8,\n  \"teacher\": { \"id\": {{teacherId}} },\n  \"category\": { \"id\": {{categoryId}} }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/courses",
              "host": ["{{baseUrl}}"],
              "path": ["api", "courses"]
            },
            "description": "После создания кеш инвалидирован: CACHE_INVALIDATE entity=Course"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Bulk Lessons - транзакции (@Transactional)",
      "description": "Два bulk endpoint: без транзакции сохранится часть данных; с транзакцией произойдет rollback",
      "item": [
        {
          "name": "Bulk create lessons WITHOUT @Transactional (ожидается частичное сохранение)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"title\": \"Lesson A\",\n    \"content\": \"ok\",\n    \"durationMinutes\": 10,\n    \"course\": { \"id\": {{courseId}} }\n  },\n  {\n    \"title\": \"FAIL\",\n    \"content\": \"boom\",\n    \"durationMinutes\": 10,\n    \"course\": { \"id\": {{courseId}} }\n  },\n  {\n    \"title\": \"Lesson C\",\n    \"content\": \"never reached\",\n    \"durationMinutes\": 10,\n    \"course\": { \"id\": {{courseId}} }\n  }\n]"
            },
            "url": {
              "raw": "{{baseUrl}}/api/lessons/bulk/no-transaction",
              "host": ["{{baseUrl}}"],
              "path": ["api", "lessons", "bulk", "no-transaction"]
            },
            "description": "Второй элемент title=FAIL вызывает ошибку. Проверь БД: первый урок должен сохраниться."
          },
          "response": []
        },
        {
          "name": "Bulk create lessons WITH @Transactional (ожидается rollback)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"title\": \"Lesson A\",\n    \"content\": \"ok\",\n    \"durationMinutes\": 10,\n    \"course\": { \"id\": {{courseId}} }\n  },\n  {\n    \"title\": \"FAIL\",\n    \"content\": \"boom\",\n    \"durationMinutes\": 10,\n    \"course\": { \"id\": {{courseId}} }\n  },\n  {\n    \"title\": \"Lesson C\",\n    \"content\": \"never reached\",\n    \"durationMinutes\": 10,\n    \"course\": { \"id\": {{courseId}} }\n  }\n]"
            },
            "url": {
              "raw": "{{baseUrl}}/api/lessons/bulk/with-transaction",
              "host": ["{{baseUrl}}"],
              "path": ["api", "lessons", "bulk", "with-transaction"]
            },
            "description": "Второй элемент title=FAIL вызывает ошибку. Проверь БД: НИ ОДИН урок не должен сохраниться (rollback)."
          },
          "response": []
        }
      ]
    },
